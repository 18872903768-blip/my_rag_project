# 复制为 ../.env（工作区根）或 ./.env（项目内）。生成与图片 caption 必填：
DEEPSEEK_API_KEY=

# ===== DeepSeek 端点（默认官方）=====
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== 向量后端 =====
# RAG_BACKEND=milvus            # milvus（默认）| faiss（离线降级）
# RAG_MILVUS_URI=http://localhost:19530
# RAG_MILVUS_COLLECTION=recipe_rag_v1
# RAG_MILVUS_TOKEN=

# ===== 数据与索引路径（相对路径基于 code/C8）=====
# RAG_DATA_PATH=../../data/C8/cook
# RAG_INDEX_PATH=./vector_index

# ===== 嵌入模型 =====
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_REVISION=7999e1d3359715c523056ef9478215996d62a620
RAG_EMBEDDING_DEVICE=cpu
RAG_NORMALIZE_EMBEDDINGS=true

# ===== 检索参数 =====
RAG_TOP_K=3
RAG_CANDIDATE_K=10
RAG_RRF_K=60
RAG_MAX_CONTEXT_CHARS=6000
RAG_GROUNDED_ANSWER=true   # 生成 prompt 追加忠实性硬约束（禁编造，RAGAS 实测 faithfulness +0.30）

# ===== 多模态图片摄取 =====
# RAG_ENABLE_IMAGE_INGESTION=true
# RAG_VISION_MODEL=deepseek-v4-flash-vision-exp
# RAG_VISION_BASE_URL=https://api.deepseek.com
# RAG_VISION_MAX_WORKERS=4

# ===== agent 管线统一上下文管理（Context Manager）=====
# RAG_CONTEXT_MANAGER=true 时 agent 生成的对话历史/检索/记忆经统一 token
# 预算与优先级组装；false 走原 _history_prefix 硬拼路径。
# RAG_CONTEXT_MANAGER=false
# RAG_CONTEXT_BUDGET=6000                  # 上下文 token 预算

# ===== 权限：哪些分类默认标记 internal（仅 staff 可见）=====
# RAG_INTERNAL_CATEGORIES=半成品

# ===== LangSmith 全链路追踪（可选）=====
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_xxx
# LANGCHAIN_PROJECT=recipe-rag-c8

# ===== 重排（cross-encoder / 云端 API 精排）=====
# 本语料实测无增益（2026-08-29：RRF 基线 MRR 0.9315 ≈ qwen3 融合 0.9315 >
# 本地 CE 融合 0.9018），默认关闭。换语料需精排时优先 dashscope：
# eval\run_eval.py 会在 .artifacts/eval 出对比报告，eval\compare_eval.py 可并排对照。
# RAG_RERANK_ENABLED=false
# RAG_RERANK_PROVIDER=local                # local（默认，本地 bge cross-encoder）| dashscope（百炼云端重排）
# RAG_RERANK_MODEL=BAAI/bge-reranker-base  # dashscope 时默认 qwen3-vl-rerank
# RAG_RERANK_POOL=20
# RAG_RERANK_TIMEOUT=10                    # dashscope 单次调用超时（秒）
# RAG_RERANK_CONTEXT=true                  # 打分文本注入"菜名（分类）"前缀（title 注入，修复盲段）

# ===== DashScope 百炼（云端重排 API）=====
# 在百炼控制台「API-KEY 管理」创建，RAG_RERANK_PROVIDER=dashscope 时必填；
# API 调用失败会自动回退本地 bge-reranker。
# DASHSCOPE_API_KEY=sk-xxx

# ===== V2 服务化 =====
# RAG_JWT_SECRET=<32位以上随机串>   # 设置后 /api/* 需要 Bearer JWT；留空=开发模式免鉴权
# 生成测试 token: python -m api.mint_token --role staff
# 启动服务: uvicorn api.app:app --port 8000
